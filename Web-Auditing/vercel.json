{
  "buildCommand": "cd Web-Auditing && npm run build",
  "devCommand": "cd Web-Auditing && npm run dev",
  "installCommand": "cd Web-Auditing && npm install",
  "framework": null,
  "outputDirectory": "Web-Auditing/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
